  "author": "Qingframe",
  "license": "MIT",
  "build": {
    "appId": "com.qingframe.web",
    "productName": "清框影",
    "executableName": "Qingframe",
    "copyright": "Copyright © 2026 清框影",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "shared/**/*",
      "frames/SKILL.md",
      "!shared/brandlogos/**",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "lumos-1s",
        "repo": "Qing-Fram-Shadow"
      }
    ],
    "win": {
      "icon": "src/main/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "category": "public.app-category.photography",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "Qingframe-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "minimumSystemVersion": "10.15",
      "darkModeSupport": true,
      "extendInfo": {
        "CFBundleDisplayName": "清框影",
        "NSHumanReadableCopyright": "Copyright © 2026 清框影"
      }
    },
    "dmg": {
      "artifactName": "Qingframe-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "清框影",
      "artifactName": "Qingframe-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Qingframe-Portable-${version}-${arch}.${ext}"
    },
    "asarUnpack": [
      "node_modules/libraw-wasm/**",
      "src/main/raw-tonemap.js"
    ]
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "electron": "^45.1.0",
    "electron-builder": "^26.0.0",
    "eslint": "^8.57.0",
    "js-yaml": "^4.3.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "exifr": "^7.1.3",
    "heic-convert": "^2.1.0",
    "libraw-wasm": "^1.6.0"
  }
}
