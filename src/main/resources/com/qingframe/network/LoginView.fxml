<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefWidth="380.0" prefHeight="470.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.qingframe.network.LoginController">

    <center>
        <VBox alignment="CENTER" spacing="13.0">
            <padding><Insets top="34.0" right="42.0" bottom="30.0" left="42.0" /></padding>

            <!-- App Logo -->
            <StackPane>
                <Circle radius="34.0" style="-fx-fill: linear-gradient(to bottom right, #6E9CF2, #4A7DE0);" />
                <Label text="清" style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;" />
            </StackPane>

            <Label text="清框影 QingFrameShadow" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: -qfx-text;" />
            <Label text="照片加框 · 模板云市场" style="-fx-font-size: 12.5px; -fx-text-fill: -qfx-text-3;" />

            <TextField fx:id="tfUsername" promptText="用户名" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 8 12;" />
            <PasswordField fx:id="tfPassword" promptText="密码" onAction="#onLogin" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 8 12;" />

            <HBox alignment="CENTER" spacing="8.0">
                <Label text="记住登录" style="-fx-text-fill: -qfx-text-2; -fx-font-size: 12px;" />
                <CheckBox fx:id="cbRemember" selected="true" />
                <Pane HBox.hgrow="ALWAYS" />
                <Label onMouseClicked="#onForgotPassword" text="忘记密码？"
                       style="-fx-text-fill: -qfx-primary; -fx-font-size: 12px; -fx-cursor: hand; -fx-underline: true;" />
            </HBox>

            <Label fx:id="lblError" style="-fx-text-fill: -qfx-danger; -fx-font-size: 12px;" text="" visible="false" />

            <HBox alignment="CENTER" spacing="12.0">
                <padding><Insets top="4.0" /></padding>
                <Button fx:id="btnLogin" onAction="#onLogin" prefWidth="135.0" prefHeight="36.0" text="登录"
                        style="-fx-background-color: linear-gradient(to bottom, #6E9CF2, #4A7DE0); -fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8;" />
                <Button fx:id="btnRegister" onAction="#onRegister" prefWidth="135.0" prefHeight="36.0" text="注册"
                        style="-fx-background-color: transparent; -fx-border-color: -qfx-primary; -fx-border-radius: 8; -fx-text-fill: -qfx-primary; -fx-font-size: 14px;" />
            </HBox>

            <Label text="没有账号？点【注册】创建（密码至少 6 位）" style="-fx-font-size: 11.5px; -fx-text-fill: -qfx-text-3;" />
        </VBox>
    </center>
</BorderPane>
