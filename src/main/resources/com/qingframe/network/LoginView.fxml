<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="360.0" prefHeight="320.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.qingframe.network.LoginController">

    <center>
        <VBox alignment="CENTER" spacing="14.0" styleClass="login-panel">
            <padding><Insets top="24.0" right="32.0" bottom="24.0" left="32.0" /></padding>

            <Label styleClass="login-title" text="清框影账号" />

            <TextField fx:id="tfUsername" promptText="用户名" />
            <PasswordField fx:id="tfPassword" promptText="密码" onAction="#onLogin" />
            <HBox alignment="CENTER" spacing="8.0">
                <Label text="记住登录" />
                <CheckBox fx:id="cbRemember" selected="true" />
            </HBox>

            <Label fx:id="lblError" styleClass="login-error" text="" visible="false" />

            <HBox alignment="CENTER" spacing="12.0">
                <Button fx:id="btnLogin" onAction="#onLogin" prefWidth="110.0" styleClass="btn-primary" text="登录" />
                <Button fx:id="btnRegister" onAction="#onRegister" prefWidth="110.0" text="注册" />
            </HBox>

            <Label styleClass="login-hint" text="没有账号？点【注册】创建（密码至少 6 位）" />
        </VBox>
    </center>
</BorderPane>
