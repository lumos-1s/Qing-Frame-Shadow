<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefWidth="380.0" prefHeight="440.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.qingframe.network.ProfileController">

    <center>
        <VBox alignment="CENTER" spacing="14.0">
            <padding><Insets top="30.0" right="40.0" bottom="30.0" left="40.0" /></padding>

            <Label text="个人资料" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: -qfx-text;" />

            <!-- 圆形头像 -->
            <StackPane>
                <ImageView fx:id="ivAvatar" fitWidth="96.0" fitHeight="96.0" preserveRatio="true">
                    <clip><Circle radius="48.0" centerX="48.0" centerY="48.0" /></clip>
                </ImageView>
                <Circle radius="48.0" fill="transparent" style="-fx-stroke: -qfx-primary; -fx-stroke-width: 2.0;" />
                <Circle radius="48.0" fill="transparent" style="-fx-stroke: -qfx-border; -fx-stroke-width: 1.0;" />
            </StackPane>
            <Button onAction="#onChooseAvatar" text="更换头像"
                    style="-fx-background-color: transparent; -fx-border-color: -qfx-primary; -fx-border-radius: 6; -fx-text-fill: -qfx-primary; -fx-font-size: 12px;" />

            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label prefWidth="52.0" text="昵称" style="-fx-text-fill: -qfx-text-2;" />
                <TextField fx:id="tfNickname" prefWidth="200.0" promptText="输入昵称（最长 50 字）" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label prefWidth="52.0" text="邮箱" style="-fx-text-fill: -qfx-text-2;" />
                <TextField fx:id="tfEmail" prefWidth="200.0" promptText="用于找回密码" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label prefWidth="52.0" text="用户名" style="-fx-text-fill: -qfx-text-2;" />
                <Label fx:id="lblUsername" style="-fx-text-fill: -qfx-text-3; -fx-font-size: 12px;" />
            </HBox>

            <Label fx:id="lblHint" text="" visible="false" style="-fx-text-fill: -qfx-warning; -fx-font-size: 12px;" />

            <HBox alignment="CENTER" spacing="12.0">
                <padding><Insets top="8.0" /></padding>
                <Button onAction="#onSave" prefWidth="130.0" prefHeight="34.0" text="保存资料"
                        style="-fx-background-color: linear-gradient(to bottom, #6E9CF2, #4A7DE0); -fx-text-fill: #FFFFFF; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 6;" />
                <Button onAction="#onLogout" prefWidth="130.0" prefHeight="34.0" text="退出登录"
                        style="-fx-background-color: transparent; -fx-border-color: -qfx-danger; -fx-border-radius: 6; -fx-text-fill: -qfx-danger; -fx-font-size: 13px;" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
