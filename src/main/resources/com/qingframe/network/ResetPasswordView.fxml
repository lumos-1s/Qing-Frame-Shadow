<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="380.0" prefHeight="430.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.qingframe.network.ResetPasswordController">

    <center>
        <VBox alignment="CENTER" spacing="14.0">
            <padding><Insets top="30.0" right="38.0" bottom="28.0" left="38.0" /></padding>

            <Label text="找回密码" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: -qfx-text;" />
            <Label text="验证码将发送到你的注册邮箱，10 分钟内有效" wrapText="true"
                   style="-fx-font-size: 12px; -fx-text-fill: -qfx-text-3; -fx-alignment: center;" />

            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <TextField fx:id="tfEmail" promptText="注册邮箱" HBox.hgrow="ALWAYS"
                           style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 8 12;" />
                <Button fx:id="btnSendCode" onAction="#onSendCode" prefWidth="96.0" prefHeight="34.0" text="获取验证码"
                        style="-fx-background-color: transparent; -fx-border-color: -qfx-primary; -fx-border-radius: 8; -fx-text-fill: -qfx-primary; -fx-font-size: 12.5px;" />
            </HBox>

            <TextField fx:id="tfCode" promptText="6 位验证码" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 8 12;" />
            <PasswordField fx:id="tfNewPassword" promptText="新密码（至少 6 位）" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 8 12;" />
            <PasswordField fx:id="tfConfirm" promptText="确认新密码" onAction="#onReset" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 8 12;" />

            <Label fx:id="lblHint" text="" visible="false" style="-fx-font-size: 12px;" />

            <Button fx:id="btnReset" onAction="#onReset" prefWidth="200.0" prefHeight="36.0" text="重置密码"
                    style="-fx-background-color: linear-gradient(to bottom, #6E9CF2, #4A7DE0); -fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8;" />
        </VBox>
    </center>
</BorderPane>
