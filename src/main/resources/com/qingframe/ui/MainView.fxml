                        </Button>
                        <Button maxWidth="1.7976931348623157E308" onAction="#onPresetCream" styleClass="sidebar-btn" text="醒图奶油风">
                            <graphic><SVGPath scaleX="0.55" scaleY="0.55" styleClass="sb-icon" content="M5 8a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3z M7 19h10" /></graphic>
                        </Button>
                        <Button maxWidth="1.7976931348623157E308" onAction="#onPresetCanvaCollage" styleClass="sidebar-btn" text="Canva错位">
                            <graphic><SVGPath scaleX="0.55" scaleY="0.55" styleClass="sb-icon" content="M5 5h12v12H5z M11 11h8v8h-8z" /></graphic>
