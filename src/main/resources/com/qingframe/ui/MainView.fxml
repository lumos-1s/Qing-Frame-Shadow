                        <Button maxWidth="1.7976931348623157E308" onAction="#onPresetNomo" styleClass="sidebar-btn" text="NOMO复古">
                            <graphic><SVGPath scaleX="0.55" scaleY="0.55" styleClass="sb-icon" content="M3 8h18v10H3z M7 5h10v3H7z M17 13m-2 0a2 2 0 1 0 4 0a2 2 0 1 0-4 0" /></graphic>
                        </Button>
