<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane fx:id="rootPane" prefHeight="900" prefWidth="1400" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.qingframe.ui.controller.MainController">

    <!-- ═══════════════ 顶部工具栏（单行平铺，无溢出折叠） ═══════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="4.0" style="-fx-background-color: -qfx-surface; -fx-border-color: transparent transparent -qfx-border transparent; -fx-border-width: 0 0 1 0; -fx-padding: 4 10;">
            <!-- 文件操作组 -->
            <HBox styleClass="toolbar-group">
                <Button fx:id="btnOpenImage" onAction="#onOpenImage" styleClass="toolbar-btn" text="打开图片">
                    <graphic><SVGPath styleClass="ui-icon" content="M3 6h6l2 2h10v12H3z" /></graphic>
                </Button>
                <Button fx:id="btnSaveImage" onAction="#onSaveImage" styleClass="toolbar-btn-primary" text="导出图片">
                    <graphic><SVGPath styleClass="ui-icon" content="M5 3h14v18H5z M5 12h14 M12 3v6" /></graphic>
                </Button>
                <ComboBox fx:id="cbExportFormat" prefWidth="64.0" promptText="导出格式" styleClass="toolbar-combo">
                    <tooltip>
                        <Tooltip text="导出图片格式：JPEG（有损压缩，体积小） / PNG（无损，画质最佳）" />
                    </tooltip>
                </ComboBox>
                <Button onAction="#onSyncToSelected" styleClass="toolbar-btn" text="同步到选中">
                    <graphic><SVGPath styleClass="ui-icon" content="M4 9a8 8 0 0 1 13.5-3.5 M20 15a8 8 0 0 1-13.5 3.5 M18 2v4h-4 M6 22v-4h4" /></graphic>
                </Button>
            </HBox>
            <!-- 编辑操作组 -->
            <HBox styleClass="toolbar-group">
                <Button onAction="#onUndo" styleClass="toolbar-btn" text="撤销">
                    <graphic><SVGPath styleClass="ui-icon" content="M9 14L4 9l5-5 M4 9h9a6 6 0 0 1 0 12h-5" /></graphic>
                </Button>
                <Button onAction="#onRedo" styleClass="toolbar-btn" text="重做">
                    <graphic><SVGPath styleClass="ui-icon" content="M15 14l5-5-5-5 M20 9h-9a6 6 0 0 0 0 12h5" /></graphic>
                </Button>
                <Button onAction="#onResetAll" styleClass="toolbar-btn-warning" text="重置">
                    <graphic><SVGPath styleClass="ui-icon" content="M4 12a8 8 0 0 1 14-5 M20 12a8 8 0 0 1-14 5 M18 3v4h-4 M6 21v-4h4" /></graphic>
                </Button>
                <Button onAction="#onRandomizeBorder" styleClass="toolbar-btn" text="随机边框">
                    <graphic><SVGPath styleClass="ui-icon" content="M12 3l1.5 4.5L18 9l-4.5 1.5L12 15l-1.5-4.5L6 9l4.5-1.5z" /></graphic>
                </Button>
            </HBox>
            <!-- 缩放控制组（滑杆+输入框已覆盖缩放，去掉冗余 +/- 按钮） -->
            <HBox styleClass="toolbar-group">
                <Button onAction="#onZoomFit" styleClass="toolbar-btn" text="适应">
                    <graphic><SVGPath styleClass="ui-icon" content="M4 9V4h5 M20 9V4h-5 M4 15v5h5 M20 15v5h-5" /></graphic>
                </Button>
                <TextField fx:id="tfZoomValue" prefWidth="48.0" styleClass="toolbar-zoom-input" />
                <Slider fx:id="zoomSlider" HBox.hgrow="ALWAYS" blockIncrement="0.1" max="3.0" min="0.1" prefWidth="120.0" value="1.0" />
            </HBox>
            <Pane HBox.hgrow="ALWAYS" />
                <!-- 账号区：固定在右侧 -->
                <HBox alignment="CENTER_RIGHT" spacing="6.0" styleClass="toolbar-group">
                    <StackPane onMouseClicked="#onOpenProfile" style="-fx-cursor: hand;">
                        <ImageView fx:id="ivAvatar" fitWidth="24.0" fitHeight="24.0" preserveRatio="true" visible="false">
                            <clip><Circle radius="12.0" centerX="12.0" centerY="12.0" /></clip>
                        </ImageView>
                        <Circle radius="12.0" fill="transparent" style="-fx-stroke: -qfx-primary; -fx-stroke-width: 1.5;" />
                    </StackPane>
                    <Label fx:id="lblLoginStatus" onMouseClicked="#onOpenProfile" text="未登录" style="-fx-text-fill: -qfx-text-2; -fx-font-size: 12px; -fx-cursor: hand;" />
                    <Button fx:id="btnLoginToggle" onAction="#onLoginToggle" styleClass="toolbar-btn" text="登录" />
                </HBox>
            <ToggleButton fx:id="btnThemeToggle" mnemonicParsing="false" onAction="#onToggleTheme" text="">
                <graphic><SVGPath styleClass="ui-icon" content="M20 13A8 8 0 1 1 11 3a6 6 0 0 0 9 10z" /></graphic>
            </ToggleButton>
        </HBox>
    </top>

    <!-- ═══════════════ 左侧侧边栏（折叠分组） ═══════════════ -->
    <left>
        <ScrollPane fx:id="sidebarScroll" fitToWidth="true" prefWidth="185.0" styleClass="sidebar-scroll">
            <VBox styleClass="sidebar-panel">
                <!-- 基础边框 -->
                <TitledPane animated="true" expanded="true" text="基础边框">
                    <graphic><SVGPath scaleX="0.55" scaleY="0.55" styleClass="sb-icon" content="M4 4h16v16H4z M8 8h8v8H8z" /></graphic>
                    <VBox styleClass="sidebar-btn-group">
                        <Button maxWidth="1.7976931348623157E308" onAction="#onPresetNoBorder" styleClass="sidebar-btn" text="无边框">
                            <graphic><SVGPath scaleX="0.55" scaleY="0.55" styleClass="sb-icon" content="M5 5h14v14H5z" /></graphic>
                        </Button>
                        <Button maxWidth="1.7976931348623157E308" onAction="#onPresetSimpleWhite" styleClass="sidebar-btn" text="简约白边">
                            <graphic><SVGPath scaleX="0.55" scaleY="0.55" styleClass="sb-icon" content="M5 5h14v14H5z M8 8h8v8H8z" /></graphic>
                        </Button>
                        <Button maxWidth="1.7976931348623157E308" onAction="#onPresetRounded" styleClass="sidebar-btn" text="圆角边框">
                            <graphic><SVGPath scaleX="0.55" scaleY="0.55" styleClass="sb-icon" content="M5 8a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3z" /></graphic>
                        </Button>
                        <Button maxWidth="1.7976931348623157E308" onAction="#onPresetVintage" styleClass="sidebar-btn" text="复古边框">
                            <graphic><SVGPath scaleX="0.55" scaleY="0.55" styleClass="sb-icon" content="M5 5h14v14H5z M9 9h6v6H9z" /></graphic>
                        </Button>
                        <Button maxWidth="1.7976931348623157E308" onAction="#onPresetPolaroid" styleClass="sidebar-btn" text="拍立得">
                            <graphic><SVGPath scaleX="0.55" scaleY="0.55" styleClass="sb-icon" content="M4 5h16v11H4z M7 16h10v3H7z" /></graphic>
                        </Button>
                        <Button maxWidth="1.7976931348623157E308" onAction="#onPresetFilm" styleClass="sidebar-btn" text="胶片框">
                            <graphic><SVGPath scaleX="0.55" scaleY="0.55" styleClass="sb-icon" content="M4 5h16v14H4z M8 5v14 M12 5v14 M16 5v14" /></graphic>
