            </VBox>
        </ScrollPane>
    </left>

    <!-- ═══════════════ 中央区域（预览 + 右侧面板） ═══════════════ -->
    <center>
        <SplitPane dividerPositions="0.72">
            <!-- 预览画布区 -->
            <VBox HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                <StackPane fx:id="dropTarget" styleClass="preview-pane" VBox.vgrow="ALWAYS">
                    <Canvas fx:id="previewCanvas" />
                    <VBox fx:id="placeholderView" styleClass="placeholder-container" visible="true" managed="true">
                <SVGPath scaleX="2.5" scaleY="2.5" styleClass="placeholder-icon" content="M4 7h4l2-2h4l2 2h4v12H4z M12 16m-3 0a3 3 0 1 0 6 0a3 3 0 1 0-6 0" />
                        <Label styleClass="placeholder-text" text="点击左上角【打开图片】导入照片开始编辑" />
                    </VBox>
                    <ScrollBar fx:id="hScrollBar" orientation="HORIZONTAL" visible="false" managed="false" />
                    <ScrollBar fx:id="vScrollBar" orientation="VERTICAL" visible="false" managed="false" />
                </StackPane>
                <ScrollPane fx:id="filmStrip" prefHeight="90.0" fitToHeight="true" hbarPolicy="ALWAYS" vbarPolicy="NEVER" styleClass="filmstrip" visible="false">
                    <HBox fx:id="thumbnailBox" spacing="4.0" />
                </ScrollPane>
            </VBox>
            <!-- 右侧面板 -->
            <TabPane fx:id="rightTabPane" side="TOP" tabClosingPolicy="UNAVAILABLE" prefWidth="310.0">
                <!-- ═══ 参数 ═══ -->
                <Tab text="参数">
                    <graphic><SVGPath styleClass="ui-icon" content="M4 7h16 M4 17h16 M9 7m-2 0a2 2 0 1 0 4 0a2 2 0 1 0-4 0 M15 17m-2 0a2 2 0 1 0 4 0a2 2 0 1 0-4 0" /></graphic>
                    <ScrollPane fitToWidth="true">
                        <VBox spacing="5.0" styleClass="settings-panel">
                            <!-- 画布比例 -->
                            <Label styleClass="param-group-title" text="画布比例" />
